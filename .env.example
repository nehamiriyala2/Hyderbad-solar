# Copy to .env.local and fill in.
# Google Apps Script web-app URL that appends leads to your Google Sheet (see docs/google-apps-script.gs)
LEADS_WEBHOOK_URL=
# Optional shared secret, must match SECRET in the Apps Script
LEADS_WEBHOOK_SECRET=

# Optional: WhatsApp Cloud API auto-reply (Meta Business). Needs an APPROVED message template.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=solar_plan_reply
WHATSAPP_TEMPLATE_LANG=en

# Public site URL (used for SEO, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.hyderabadsolar.in
